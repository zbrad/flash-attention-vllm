# tuned/repo.env -- flash-attention-vllm-specific settings for tuned builds. Sourced by tuned/env.sh after the shared
# device and toolkit definitions (tuned/common-data, vendored from zbrad/tuned-common). Tracked, so a release is
# reproducible.
#
# This file only ADDS repo-specific settings. Changing a shared key (GPU_TUNED_VARIANT/PLATFORM/CUDA_ARCH/
# HW_LABEL, CUDA_*, TOOLKIT_*) is a loud error from gpu_tuned_load_repo_env. Plain assignment on purpose:
# this file is sourced inside a function, where `declare` would make the variable local and lose it.

# Upstream ref the build-info stamp and the DRAFT notes compare against (the merge-base of HEAD with it).
GPU_TUNED_UPSTREAM_REF="${GPU_TUNED_UPSTREAM_REF:-upstream/main}"

# GPU_TUNED_FA2_ARCH is this repo's own arch spelling (setup.py reads it as CUDA_ARCHS and FA2_TUNED_ARCH, which
# CMakeLists.txt takes in the dotted "12.1a" form), where the shared device files carry the resolved cuobjdump form
# ("121a"). The values are the ones tuned/devices/<variant>.conf held before it moved to the shared data.
case "${GPU_TUNED_VARIANT}" in
    gb10) GPU_TUNED_FA2_ARCH="12.1a" ;;
    rtx40) GPU_TUNED_FA2_ARCH="8.9" ;;
    rtx50) GPU_TUNED_FA2_ARCH="12.0a" ;;
esac
